name: Render Videos

# Chạy khi:
#  1) Bạn bấm nút "Run workflow" trong tab Actions (workflow_dispatch), HOẶC
#  2) Bạn commit/sửa jobs.json (push).
on:
  workflow_dispatch:
    inputs:
      jobs_file:
        description: "File cấu hình job (mặc định jobs.json)"
        required: false
        default: "jobs.json"
  push:
    paths:
      - "jobs.json"
      - "pipeline/**"

# Job render video có thể dài — cho tối đa 350 phút (dưới trần 360 của GitHub).
jobs:
  render:
    runs-on: ubuntu-latest
    timeout-minutes: 350
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install ffmpeg + yt-dlp
        run: |
          sudo apt-get update -y
          sudo apt-get install -y ffmpeg
          ffmpeg -version | head -1
          pip install --upgrade yt-dlp

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install Python deps
        run: pip install -r requirements.txt

      - name: Render jobs
        env:
          DROPBOX_APP_KEY: ${{ secrets.DROPBOX_APP_KEY }}
          DROPBOX_APP_SECRET: ${{ secrets.DROPBOX_APP_SECRET }}
          DROPBOX_REFRESH_TOKEN: ${{ secrets.DROPBOX_REFRESH_TOKEN }}
          OUTPUT_DIR: outputs
        run: |
          JOBS_FILE="${{ github.event.inputs.jobs_file }}"
          if [ -z "$JOBS_FILE" ]; then JOBS_FILE="jobs.json"; fi
          echo "Using jobs file: $JOBS_FILE"
          python pipeline/run_jobs.py "$JOBS_FILE"

      - name: Upload outputs as artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: rendered-videos
          path: outputs/
          if-no-files-found: ignore
          retention-days: 7
